# AI Companion 环境变量配置文件示例
# 复制此文件为 .env 并填入实际值

# ===== API 配置 =====
API_KEY=your_api_key_here
AGENT_API_KEY=your_api_key_here

# ===== Redis 配置 =====
# 使用 Docker 内置 Redis 时使用默认值
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=
REDIS_PREFIX=ai_companion:

# 使用外部 Redis 时修改为实际值
# REDIS_HOST=your_redis_host
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ===== ChromaDB 配置 =====
# 使用 Docker 内置 ChromaDB 时使用默认值
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# 使用外部 ChromaDB 时修改为实际值
# CHROMA_HOST=your_chroma_host
# CHROMA_PORT=8000

# 向量数据库模式: local 或 remote
VECTOR_DB_MODE=remote

# ===== Embedding 配置 =====
EMBEDDING_TYPE=api
EMBEDDING_MODEL=embedding-3
EMBEDDING_API_KEY=your_api_key_here
